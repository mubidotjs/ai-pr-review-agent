{
  "name": "ai-pr-review-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsx scripts/verify-boundaries.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:worker": "tsx scripts/profile-worker.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "benchmark:browser": "tsx scripts/benchmark-browser.ts",
    "benchmark:ui": "tsx scripts/benchmark-ui.ts",
    "benchmark:ingestion": "tsx scripts/benchmark-ingestion.ts"
  },
  "dependencies": {
    "@babel/parser": "8.1.2",
    "hono": "4.13.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.161.0",
    "ws": "8.23.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
